@model Patient
@{
    ViewData["Title"] = "Patient Details";
}
<div class="page-heading"><h1>Patient Details</h1></div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Full Name</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9">@Model.DateOfBirth.ToString("MMM dd, yyyy")</dd>
        <dt class="col-sm-3">Gender</dt><dd class="col-sm-9">@Model.Gender</dd>
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.PhoneNumber</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(Model.Email ?? "-")</dd>
        <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@(Model.Address ?? "-")</dd>
    </dl>
    <a asp-action="Index" class="btn btn-clinic-outline mt-3">Back to list</a>
</div>

<div class="panel">
    <div class="panel-title">Appointment History</div>
    @if (!Model.Appointments.Any())
    {
        <p class="text-muted small mb-0">No appointments yet.</p>
    }
    else
    {
        <table class="table-clinic">
            <thead><tr><th>Date</th><th>Doctor</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                {
                    <tr>
                        <td>@a.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")</td>
                        <td>Dr. @a.Doctor?.FullName</td>
                        <td><span class="badge-status badge-@a.Status.ToString().ToLower()">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="panel">
    <div class="panel-title">Visit Records</div>
    @if (!Model.Visits.Any())
    {
        <p class="text-muted small mb-0">No visit records yet.</p>
    }
    else
    {
        <table class="table-clinic">
            <thead><tr><th>Date</th><th>Doctor</th><th>Diagnosis</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Visits.OrderByDescending(v => v.VisitDate))
                {
                    <tr>
                        <td>@v.VisitDate.ToString("MMM dd, yyyy")</td>
                        <td>Dr. @v.Doctor?.FullName</td>
                        <td>@(v.Diagnosis ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
