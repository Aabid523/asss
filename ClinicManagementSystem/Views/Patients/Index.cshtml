@model IEnumerable<Patient>
@{
    ViewData["Title"] = "Patients";
}
<div class="page-heading">
    <h1>Patients</h1>
    <a asp-action="Create" class="btn btn-clinic-primary"><i class="bi bi-plus-lg"></i> Register Patient</a>
</div>

<div class="panel p-0">
    <div class="table-toolbar px-3 pt-3">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control form-control-sm" placeholder="Search by name or phone..." style="width:260px;" />
            <button type="submit" class="btn btn-sm btn-clinic-outline"><i class="bi bi-search"></i></button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-people"></i> No patients found.</div>
    }
    else
    {
        <table class="table-clinic">
            <thead>
                <tr><th>Full Name</th><th>Gender</th><th>Date of Birth</th><th>Phone</th><th>Email</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Gender</td>
                        <td>@item.DateOfBirth.ToString("MMM dd, yyyy")</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Email</td>
                        <td class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-outline">View</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-outline">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
