@model Specialty
@{
    ViewData["Title"] = "Edit Specialty";
}
<div class="page-heading"><h1>Edit Specialty</h1></div>

<div class="panel form-panel">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-clinic-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-clinic-outline">Cancel</a>
    </form>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
