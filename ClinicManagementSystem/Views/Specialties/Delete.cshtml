@model Specialty
@{
    ViewData["Title"] = "Delete Specialty";
}
<div class="page-heading"><h1>Delete Specialty</h1></div>

<div class="panel form-panel">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    @if (Model.Doctors.Any())
    {
        <div class="alert-error-custom">This specialty has @Model.Doctors.Count doctor(s) assigned and cannot be deleted.</div>
    }
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-clinic-danger" @(Model.Doctors.Any() ? "disabled" : "")>Yes, Delete</button>
        <a asp-action="Index" class="btn btn-clinic-outline">Cancel</a>
    </form>
</div>
