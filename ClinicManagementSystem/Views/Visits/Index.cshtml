@model IEnumerable<Visit>
@{
    ViewData["Title"] = "Visit Records";
}
<div class="page-heading">
    <h1>Visit Records</h1>
    <a asp-action="Create" class="btn btn-clinic-primary"><i class="bi bi-plus-lg"></i> New Visit Record</a>
</div>

<div class="panel p-0">
    <div class="table-toolbar px-3 pt-3">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control form-control-sm" placeholder="Search by patient or doctor..." style="width:260px;" />
            <button type="submit" class="btn btn-sm btn-clinic-outline"><i class="bi bi-search"></i></button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-clipboard2-pulse"></i> No visit records found.</div>
    }
    else
    {
        <table class="table-clinic">
            <thead><tr><th>Date</th><th>Patient</th><th>Doctor</th><th>Diagnosis</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.VisitDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.Patient?.FullName</td>
                        <td>Dr. @item.Doctor?.FullName</td>
                        <td>@(item.Diagnosis ?? "-")</td>
                        <td class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-outline">View</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-outline">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-clinic-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
