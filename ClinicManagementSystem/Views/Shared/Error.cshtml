@{
    ViewData["Title"] = "Error";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-exclamation-octagon" style="font-size:2.5rem;color:#C0392B;"></i>
        <h2 class="mt-3">Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-clinic-primary mt-2">Back to Home</a>
    </div>
</div>
