<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="app-shell">
            <nav class="sidebar">
                <div class="sidebar-brand">
                    <i class="bi bi-heart-pulse-fill"></i>
                    <span>Clinic<strong>MS</strong></span>
                </div>
                <ul class="sidebar-nav">
                    <li>
                        <a asp-controller="Dashboard" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                            <i class="bi bi-grid-1x2"></i> Dashboard
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li>
                            <a asp-controller="Patients" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "active" : "")">
                                <i class="bi bi-people"></i> Patients
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Appointments" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "active" : "")">
                            <i class="bi bi-calendar3"></i> Appointments
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                    {
                        <li>
                            <a asp-controller="Visits" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Visits" ? "active" : "")">
                                <i class="bi bi-clipboard2-pulse"></i> Visit Records
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li>
                            <a asp-controller="Doctors" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctors" ? "active" : "")">
                                <i class="bi bi-person-badge"></i> Doctors
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Specialties" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Specialties" ? "active" : "")">
                                <i class="bi bi-tags"></i> Specialties
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-section">Administration</li>
                        <li>
                            <a asp-controller="Account" asp-action="RegisterStaff" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "RegisterStaff" ? "active" : "")">
                                <i class="bi bi-person-plus"></i> Add Staff
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Account" asp-action="ManageUsers" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageUsers" ? "active" : "")">
                                <i class="bi bi-people-fill"></i> Staff Accounts
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="main-area">
                <header class="topbar">
                    <div class="topbar-title">@ViewData["Title"]</div>
                    <div class="topbar-user">
                        <span class="user-name">@User.Identity!.Name</span>
                        <span class="user-role-badge">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : "Receptionist")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
                        </form>
                    </div>
                </header>

                <main class="content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success-custom">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-error-custom">@TempData["ErrorMessage"]</div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
