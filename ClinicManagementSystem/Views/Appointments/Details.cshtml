@model Appointment
@{
    ViewData["Title"] = "Appointment Details";
}
<div class="page-heading"><h1>Appointment Details</h1></div>

<div class="panel form-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@Model.Patient?.FullName</dd>
        <dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">Dr. @Model.Doctor?.FullName (@Model.Doctor?.Specialty?.Name)</dd>
        <dt class="col-sm-3">Date &amp; Time</dt><dd class="col-sm-9">@Model.AppointmentDate.ToString("dddd, MMM dd yyyy - h:mm tt")</dd>
        <dt class="col-sm-3">Duration</dt><dd class="col-sm-9">@Model.DurationMinutes minutes</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge-status badge-@Model.Status.ToString().ToLower()">@Model.Status</span></dd>
        <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
    </dl>

    <div class="d-flex gap-2 mt-3">
        <a asp-action="Index" class="btn btn-clinic-outline">Back to Calendar</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-clinic-outline">Edit</a>
        }
        @if ((User.IsInRole("Admin") || User.IsInRole("Doctor")) && Model.Visit == null && Model.Status != AppointmentStatus.Cancelled)
        {
            <a asp-controller="Visits" asp-action="Create" asp-route-appointmentId="@Model.Id" class="btn btn-clinic-primary">Record Visit</a>
        }
        @if (Model.Visit != null)
        {
            <a asp-controller="Visits" asp-action="Details" asp-route-id="@Model.Visit.Id" class="btn btn-clinic-outline">View Visit Record</a>
        }
    </div>
</div>
